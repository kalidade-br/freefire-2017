rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNearRequestTime(ts) {
      return ts is timestamp
        && ts >= request.time - duration.value(2, 'm')
        && ts <= request.time + duration.value(2, 'm');
    }

    function isValidUserPublicProfile(data, uid) {
      return data.keys().hasAll([
          'uid',
          'publicId',
          'nickname',
          'level',
          'gold',
          'gems',
          'matchesPlayed',
          'wins',
          'rankPoints',
          'rankedMatches',
          'rankedWins',
          'totalKills',
          'characterModelId',
          'avatarId',
          'unlockedAvatars',
          'seasonId',
          's1PeakRankPoints',
          's1ClaimedRewards',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'publicId',
          'nickname',
          'level',
          'gold',
          'gems',
          'matchesPlayed',
          'wins',
          'rankPoints',
          'rankedMatches',
          'rankedWins',
          'totalKills',
          'characterModelId',
          'avatarId',
          'unlockedAvatars',
          'seasonId',
          's1PeakRankPoints',
          's1ClaimedRewards',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.publicId is string
        && data.publicId.size() >= 4
        && data.publicId.size() <= 16
        && data.publicId.matches('^[0-9]+$')
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 24
        && data.level is int
        && data.level >= 1
        && data.level <= 999
        && data.gold is int
        && data.gold >= 0
        && data.gold <= 100000000
        && data.gems is int
        && data.gems >= 0
        && data.gems <= 100000000
        && data.matchesPlayed is int
        && data.matchesPlayed >= 0
        && data.matchesPlayed <= 1000000
        && data.wins is int
        && data.wins >= 0
        && data.wins <= 1000000
        && data.rankPoints is int
        && data.rankPoints >= 0
        && data.rankPoints <= 1000000
        && data.rankedMatches is int
        && data.rankedMatches >= 0
        && data.rankedMatches <= 1000000
        && data.rankedWins is int
        && data.rankedWins >= 0
        && data.rankedWins <= 1000000
        && data.totalKills is int
        && data.totalKills >= 0
        && data.totalKills <= 10000000
        && data.characterModelId is string
        && data.characterModelId.size() <= 16
        && data.characterModelId in ['adam', 'eva', 'maxim', 'kelly']
        && data.avatarId is string
        && data.avatarId.size() <= 24
        && data.avatarId in ['default', 'adam', 'eva', 'maxim', 'kelly', 'angelic', 'eagle_eye']
        && (!(data.avatarId in ['angelic', 'eagle_eye']) || data.s1PeakRankPoints >= 3100 || data.rankPoints >= 3100)
        && data.unlockedAvatars is list
        && data.unlockedAvatars.size() >= 1
        && data.unlockedAvatars.size() <= 10
        && data.unlockedAvatars[0] is string
        && data.unlockedAvatars[0].size() <= 24
        && (!('angelic' in data.unlockedAvatars) || data.s1PeakRankPoints >= 3100 || data.rankPoints >= 3100)
        && (!('eagle_eye' in data.unlockedAvatars) || data.s1PeakRankPoints >= 3100 || data.rankPoints >= 3100)
        && data.seasonId is string
        && data.seasonId == 'S1'
        && data.s1PeakRankPoints is int
        && data.s1PeakRankPoints >= 0
        && data.s1PeakRankPoints <= 1000000
        && data.s1ClaimedRewards is list
        && data.s1ClaimedRewards.size() <= 10
        && (data.s1ClaimedRewards.size() == 0 || (data.s1ClaimedRewards[0] is string && data.s1ClaimedRewards[0].size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isValidId(uid)
        && isVerifiedUser()
        && isOwner(uid)
        && isValidUserPublicProfile(incoming(), uid)
        && isNearRequestTime(incoming().createdAt)
        && isNearRequestTime(incoming().updatedAt);

      allow update: if isValidId(uid)
        && isVerifiedUser()
        && isOwner(uid)
        && isValidUserPublicProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().publicId == existing().publicId
        && incoming().createdAt == existing().createdAt
        && isNearRequestTime(incoming().updatedAt)
        && (
          // Action: Update player stats, currency, nickname, avatar, Season 1 progress, or character selection
          incoming().diff(existing()).affectedKeys().hasOnly([
            'nickname',
            'level',
            'gold',
            'gems',
            'matchesPlayed',
            'wins',
            'rankPoints',
            'rankedMatches',
            'rankedWins',
            'totalKills',
            'characterModelId',
            'avatarId',
            'unlockedAvatars',
            'seasonId',
            's1PeakRankPoints',
            's1ClaimedRewards',
            'updatedAt'
          ])
        );

      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(uid) && isValidId(docId) && docId == 'info' && isOwner(uid);
        allow list: if false;

        allow create: if isValidId(uid)
          && isValidId(docId)
          && docId == 'info'
          && isVerifiedUser()
          && isOwner(uid)
          && isValidUserPrivateInfo(incoming(), uid)
          && isNearRequestTime(incoming().updatedAt);

        allow update: if isValidId(uid)
          && isValidId(docId)
          && docId == 'info'
          && isVerifiedUser()
          && isOwner(uid)
          && isValidUserPrivateInfo(incoming(), uid)
          && incoming().uid == existing().uid
          && isNearRequestTime(incoming().updatedAt)
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if false;
      }
    }
  }
}
